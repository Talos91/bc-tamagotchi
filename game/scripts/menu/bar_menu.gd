extends RefCounted
## Black Cabin's real menu for the game (res://data/menu.json, generated by tools/menu_build.py from the
## transcription docs/venue/menu/menu.json). Static helpers: items by group, names in the current locale, the rule
## effect of each item, prices, the Try something new order and the Pour Perfect drinks. Strings live in
## res://i18n/strings_menu.csv, read at runtime like scripts/zones/venue_strings.gd does.
##
## Effects (what ordering an item does; every number stays in scripts/rules.gd):
##   alcohol  order_drink (+15 Drinks), +1 tipsiness, blocked while Merry  (was: Order a drink, the invented drinks)
##   soft     order_drink (+15 Drinks), no tipsiness                       (was: Thai iced tea)
##   water    order_drink (+15 Drinks), tipsiness drops one state          (was: A glass of water)
##   none     nothing yet (the Kitchen list)

const DATA_PATH := "res://data/menu.json"
const CSV_PATH := "res://i18n/strings_menu.csv"
const PROBE := "menu.head"

static var _data: Dictionary = {}
static var _by_id: Dictionary = {}
static var _strings_installed := false


static func data() -> Dictionary:
	if _data.is_empty():
		var f := FileAccess.open(DATA_PATH, FileAccess.READ)
		if f == null:
			push_error("bar_menu: cannot open " + DATA_PATH)
			return {}
		var parsed = JSON.parse_string(f.get_as_text())
		if typeof(parsed) != TYPE_DICTIONARY:
			push_error("bar_menu: bad JSON in " + DATA_PATH)
			return {}
		_data = parsed
		for it in _data["items"]:
			_by_id[it["id"]] = it
	return _data


## All items, or those of one group ("drinks" or "kitchen"), in menu order.
static func items(group := "") -> Array:
	var out: Array = []
	for it in data().get("items", []):
		if group == "" or it["group"] == group:
			out.append(it)
	return out


static func item(id: String) -> Dictionary:
	data()
	return _by_id.get(id, {})


static func has(id: String) -> bool:
	return not item(id).is_empty()


## Sections of one group in menu order: [{id, title, items}].
static func sections(group: String) -> Array:
	var out: Array = []
	for s in data().get("sections", []):
		if s["group"] != group:
			continue
		var its: Array = []
		for it in items(group):
			if it["section"] == s["id"]:
				its.append(it)
		out.append({"id": s["id"], "title": t(s["title_key"]), "items": its})
	return out


static func thai() -> bool:
	return TranslationServer.get_locale().begins_with("th")


## Display name in the current locale (Thai names are a draft for Black Cabin staff to check).
static func name_of(id: String) -> String:
	var it := item(id)
	if it.is_empty():
		return id
	return str(it["name_th"] if thai() else it["name_en"])


## "alcohol", "soft", "water" or "none".
static func effect(id: String) -> String:
	return str(item(id).get("effect", "none"))


static func effect_def(id: String) -> Dictionary:
	return data().get("effects", {}).get(effect(id), {})


## The six Try something new drinks, one per drink family, in their fixed (printed-data) order.
static func try_order() -> Array:
	return data().get("try_order", [])


## The drink Try something new offers on bar night `night`: the first one `tried` (id -> true) does not hold yet, going
## round the six from (night % 6), so every night opens on the next drink; "" once all six are tried. Menu orders
## count as tried (VenueSession.mark_tried).
static func try_pick(tried: Dictionary, night := 0) -> String:
	var o := try_order()
	for i in o.size():
		var d: String = o[posmod(night + i, o.size())]
		if not tried.has(d):
			return d
	return ""


## Bottle bundles (the Seppuku and the five on the brandy page) in menu order: [{id, name, bottles, price, was}].
## Shown in the menu list's Bundles tab; not orderable (no coin price yet). `was` is the printed struck-through price.
static func bundles() -> Array:
	var out: Array = []
	for b in data().get("bundles", []):
		out.append({"id": b["id"], "name": b["name_en"], "bottles": " + ".join(b["bottles_en"]),
			"price": int(b["now"]), "was": int(b["was"])})
	return out


static func bundle_price_text(price: int) -> String:
	return t("menu.price.serve", {"n": _thousands(price)})


## Pour Perfect's twelve drink families in rotation order: [{id, categories, drink}], one featured drink each
## (Daniele 2026-11-02: "a rotation of 12 drinks, one per drink family"; defined in tools/menu_build.py).
static func pour_families() -> Array:
	return data().get("pour_families", [])


## The featured drinks, one per family, in rotation order.
static func pour_featured() -> Array:
	return data().get("pour_featured", [])


## The family an item belongs to ("" for kitchen, soft drinks and water).
static func family_of(id: String) -> String:
	var cat := str(item(id).get("category", ""))
	for f in pour_families():
		if cat in f["categories"]:
			return str(f["id"])
	return ""


## The bar night a moment belongs to: whole days on Bangkok time (UTC+7) turning over at 06:00, so a night out
## (Tue-Sun 19:00-02:00) is one night and every player sees the same drink of the night.
static func night_of(unix_time: float) -> int:
	return floori((unix_time + (7 - 6) * 3600.0) / 86400.0)


## The drink Pour Perfect features on the n-th pour of a visit on bar night `night`: tonight's rotation starts at
## family (night % 12) and each further pour moves on one family, so every night opens on the next one and twelve
## pours in a row cover all twelve families. A soft drink while Merry.
static func pour_pick(n: int, merry := false, night := 0) -> String:
	if merry:
		return str(data().get("pour_merry", ""))
	var f := pour_featured()
	return "" if f.is_empty() else str(f[posmod(night + n, f.size())])


## Three layer colours (bottom to top) for Pour Perfect, or [] if the drink has no pour style.
static func pour_colors(id: String) -> Array[Color]:
	var it := item(id)
	var style := str(it.get("pour_style", "soft" if it.get("effect", "") == "soft" else ""))
	var out: Array[Color] = []
	for hex in data().get("pour_colors", {}).get(style, []):
		out.append(Color(hex))
	return out


static func price_text(id: String) -> String:
	var it := item(id)
	if it.is_empty() or it.get("price") == null:
		return ""
	var n := _thousands(int(it["price"]))
	match str(it.get("price_unit", "serve")):
		"glass":
			return t("menu.price.glass", {"n": n})
		"bottle":
			return t("menu.price.bottle", {"n": n})
		"deal_5_free_1":
			return t("menu.price.deal", {"n": n})
	return t("menu.price.serve", {"n": n})


static func _thousands(v: int) -> String:
	var s := str(v)
	var out := ""
	while s.length() > 3:
		out = "," + s.substr(s.length() - 3) + out
		s = s.substr(0, s.length() - 3)
	return s + out


# --- Strings -------------------------------------------------------------------------------------

static func install_strings() -> void:
	if _strings_installed:
		return
	_strings_installed = true
	if String(TranslationServer.translate(PROBE)) != PROBE:
		return
	var f := FileAccess.open(CSV_PATH, FileAccess.READ)
	if f == null:
		return
	var by_lang := {"en": Translation.new(), "th": Translation.new()}
	for l in by_lang:
		by_lang[l].locale = l
	f.get_csv_line()  # header
	while not f.eof_reached():
		var r := f.get_csv_line()
		if r.size() >= 3 and r[0] != "":
			by_lang["en"].add_message(r[0], r[1])
			by_lang["th"].add_message(r[0], r[2])
	for l in by_lang:
		TranslationServer.add_translation(by_lang[l])


## Translated menu string with {named} placeholders filled from `vars`.
static func t(key: String, vars: Dictionary = {}) -> String:
	install_strings()
	var s := String(TranslationServer.translate(key))
	return s.format(vars) if not vars.is_empty() else s

extends RefCounted
## Black Cabin merch (Daniele 2026-11-20): special pieces on top of the wardrobe kit, ten per category (head, eyes,
## top, acc). Catalogue res://data/merch.json, generated by tools/merch_catalog.py (also writes the server seed).
## What a player wears lives in the avatar record as `merch`: {"head": id, "eyes": id, "top": id, "acc": id}. Avatar
## normalize() keeps unknown keys, so the record carries it through saves, the creator and presence (other players'
## figures draw it too); a client from before the merch shop just ignores it.
## The pieces are voxels built here at runtime (VOX 5 cm, the kit's axes) and attached to the figure's "head" and
## "spine" bones, so they follow every animation; tops recolour the kit's top and add a chest print (a front decal,
## as the kit's eyes are). Masks and wigs hide the parts they cover; hats swap the hair for its cut-at-the-brim
## variant when the library has one (wardrobe kit v2).
## Hooks: venue_patron_figure.gd calls adjust() on the resolved parts and dress() on the built model.

const Avatar = preload("res://scripts/avatar.gd")
const Chars = preload("res://assets/chars/bc_chars.gd")

const DATA_PATH := "res://data/merch.json"
const VOX := 0.05
const SLOTS := ["head", "eyes", "top", "acc"]
const ANCHOR := {"head": "head", "eyes": "head", "top": "spine", "acc": "spine"}
## tools/blender/bc_chars.py BODIES: torso width, depth, chest rows, leg rows (incl. shoes)
const BODIES := {
	"petite": {"tw": 8, "td": 5, "chest": 8, "leg": 10},
	"regular": {"tw": 8, "td": 5, "chest": 9, "leg": 11},
	"broad": {"tw": 10, "td": 6, "chest": 10, "leg": 11},
	"tall": {"tw": 8, "td": 5, "chest": 10, "leg": 13},
}
const NODE_PREFIX := "Merch_"

static var _data: Dictionary = {}
static var _by_id: Dictionary = {}
static var _meshes: Dictionary = {}     ## "id|body" -> ArrayMesh
static var _mats: Array = []


static func data() -> Dictionary:
	if _data.is_empty():
		_data = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
		for it in _data["items"]:
			_by_id[str(it["id"])] = it
	return _data


static func item(id: String) -> Dictionary:
	data()
	return _by_id.get(id, {})


static func has_item(id: String) -> bool:
	data()
	return _by_id.has(id)


## Items of one category in shop order.
static func items(cat: String) -> Array:
	var out := []
	for it in data()["items"]:
		if it["cat"] == cat:
			out.append(it)
	out.sort_custom(func(a, b): return int(a["sort"]) < int(b["sort"]))
	return out


static func all_ids() -> Array:
	var out := []
	for it in data()["items"]:
		out.append(str(it["id"]))
	return out


## The record's worn merch, cleaned: only known ids in their own category's slot.
static func worn(rec: Variant) -> Dictionary:
	var out := {}
	if not (rec is Dictionary) or not (rec.get("merch") is Dictionary):
		return out
	var m: Dictionary = rec["merch"]
	for slot in m:
		var id := str(m[slot])
		if slot in SLOTS and has_item(id) and item(id)["cat"] == slot:
			out[slot] = id
	return out


## A copy of `rec` wearing `id` in its category's slot ("" in `slot` takes that slot off).
static func wear(rec: Dictionary, id: String, slot := "") -> Dictionary:
	var r := rec.duplicate(true)
	var m := worn(r)
	if id == "":
		m.erase(slot)
	elif has_item(id):
		m[item(id)["cat"]] = id
	r["merch"] = m
	return r


## Every part prefix the worn merch hides (masks, wigs).
static func hidden_prefixes(rec: Variant) -> Array:
	var out := []
	for slot in worn(rec):
		for p in item(worn(rec)[slot]).get("hides", []):
			out.append(str(p))
	return out


static func _hidden(name: String, prefixes: Array) -> bool:
	for p in prefixes:
		if name.begins_with(p):
			return true
	return false


## Hook (figure, before the parts library is cut down): drop the parts the merch hides; a hat swaps the hair for its
## cut-at-the-brim variant when the kit has one.
static func adjust(res: Dictionary, rec: Variant) -> Dictionary:
	var w := worn(rec)
	if w.is_empty():
		return res
	var out := res.duplicate(true)
	var hides := hidden_prefixes(rec)
	var hat := w.has("head") and bool(item(w["head"]).get("hat", false))
	var ids := []
	for id in out["ids"]:
		var s := str(id)
		if _hidden(s, hides):
			continue
		if hat and s.begins_with("hair_") and not s.ends_with("_hat"):
			Avatar.data()
			var kit: Dictionary = Avatar._kit.get("hair", {})
			if kit.has(s.trim_prefix("hair_") + "_hat"):
				s += "_hat"
		ids.append(s)
	out["ids"] = ids
	return out


## Hook (figure, after the model is built or re-shown): hide what the merch covers, recolour the top, attach the
## voxel pieces to the head and spine bones. Safe to call again: the previous pieces are replaced.
static func dress(model: Node, rec: Variant) -> void:
	if model == null:
		return
	var sks := model.find_children("*", "Skeleton3D", true, false)
	if sks.is_empty():
		return
	var sk: Skeleton3D = sks[0]
	for c in sk.get_children():
		if String(c.name).begins_with(NODE_PREFIX):
			sk.remove_child(c)
			c.free()
	var w := worn(rec)
	if w.is_empty():
		return
	var hides := hidden_prefixes(rec)
	if not hides.is_empty():
		for mi: MeshInstance3D in model.find_children("*", "MeshInstance3D", true, false):
			if _hidden(String(mi.name), hides):
				mi.visible = false
	var body := str(rec.get("body", "regular")) if rec is Dictionary else "regular"
	if not BODIES.has(body):
		body = "regular"
	if w.has("top") and str(item(w["top"]).get("top_colour", "")) != "":
		Chars.recolour(model, "top", Color(item(w["top"])["top_colour"]))
	for slot in SLOTS:
		if not w.has(slot):
			continue
		var bone := sk.find_bone(ANCHOR[slot])
		if bone < 0:
			continue
		var att := BoneAttachment3D.new()
		att.name = NODE_PREFIX + slot
		att.bone_name = ANCHOR[slot]
		var mi := MeshInstance3D.new()
		mi.name = w[slot]
		mi.mesh = mesh_for(w[slot], body)
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		# Vertices are in skeleton space around the anchor; undo the bone's rest so they sit there at rest.
		var anchor := Vector3(0, anchor_row(slot, body) * VOX, 0)
		mi.transform = sk.get_bone_global_rest(bone).affine_inverse() * Transform3D(Basis(), anchor)
		att.add_child(mi)
		sk.add_child(att)


## The anchor's row in voxels: the head sits on row h, the chest starts two rows above the legs.
static func anchor_row(slot: String, body: String) -> int:
	var b: Dictionary = BODIES[body]
	var spine: int = b["leg"] + 2
	return spine + b["chest"] if ANCHOR[slot] == "head" else spine


# --- Voxel meshes --------------------------------------------------------------------------------

## Cells {Vector3i: colour key} and front decals [[x, z, key]] of one item for one body.
static func cells_for(id: String, body: String) -> Dictionary:
	var it := item(id)
	var b: Dictionary = BODIES.get(body, BODIES["regular"])
	var x0 := -int(b["tw"]) / 2
	var y0 := -int(b["td"]) / 2
	var vars := {"X0": x0, "X1": x0 + int(b["tw"]) - 1, "Y0": y0, "Y1": y0 + int(b["td"]) - 1, "C": int(b["chest"])}
	var cells := {}
	for bx in it.get("boxes", []):
		var r := []
		for i in 6:
			r.append(_coord(bx[i], vars))
		for x in range(mini(r[0], r[1]), maxi(r[0], r[1]) + 1):
			for y in range(mini(r[2], r[3]), maxi(r[2], r[3]) + 1):
				for z in range(mini(r[4], r[5]), maxi(r[4], r[5]) + 1):
					cells[Vector3i(-1 - x, y, z)] = str(bx[6])   # catalogue x is the viewer's right: mirror
	var top := int(it.get("face_top", 0))
	var rows: Array = it.get("face", [])
	for ri in rows.size():
		var row: String = rows[ri]
		for i in row.length():
			if row[i] != ".":
				cells[Vector3i(-1 - (i - 5), -4, top - ri)] = row[i]
	var decals := []
	var chest: Array = it.get("chest", [])
	for ri in chest.size():
		var row: String = chest[ri]
		var start := -(row.length() / 2)
		for i in row.length():
			var x := start + i
			if row[i] != "." and x >= vars["X0"] and x <= vars["X1"]:
				decals.append([-1 - x, vars["C"] - 2 - ri, row[i]])
	return {"cells": cells, "decals": decals, "y0": y0}


static func _coord(v: Variant, vars: Dictionary) -> int:
	if typeof(v) == TYPE_FLOAT or typeof(v) == TYPE_INT:
		return int(v)
	var s := str(v)
	var m := RegEx.create_from_string("^([A-Z][0-9]?)([+-][0-9]+)?$").search(s)
	if m == null:
		return int(s)
	return int(vars.get(m.get_string(1), 0)) + (int(m.get_string(2)) if m.get_string(2) != "" else 0)


static func _colour(it: Dictionary, key: String) -> Array:
	var s := str(it["palette"].get(key, "#FF00FF"))
	return [Color(s.trim_suffix("!")), s.ends_with("!")]


## The item as an ArrayMesh in skeleton-space metres around its anchor (two surfaces: matte, glowing).
static func mesh_for(id: String, body: String) -> ArrayMesh:
	var key := id + "|" + body
	if _meshes.has(key):
		return _meshes[key]
	var it := item(id)
	var c := cells_for(id, body)
	var cells: Dictionary = c["cells"]
	var st := [SurfaceTool.new(), SurfaceTool.new()]
	var used := [false, false]
	for s in st:
		s.begin(Mesh.PRIMITIVE_TRIANGLES)
	const DIRS := [Vector3i(1, 0, 0), Vector3i(-1, 0, 0), Vector3i(0, 1, 0), Vector3i(0, -1, 0), Vector3i(0, 0, 1), Vector3i(0, 0, -1)]
	for cell: Vector3i in cells:
		var col := _colour(it, cells[cell])
		var k := 1 if col[1] else 0
		for d: Vector3i in DIRS:
			if cells.has(cell + d):
				continue
			_face(st[k], cell, d, col[0])
			used[k] = true
	for dc in c["decals"]:
		var col := _colour(it, dc[2])
		var k := 1 if col[1] else 0
		_decal(st[k], dc[0], c["y0"], dc[1], col[0])
		used[k] = true
	var mesh := ArrayMesh.new()
	for k in 2:
		if used[k]:
			st[k].set_material(_material(k == 1))
			st[k].commit(mesh)
	_meshes[key] = mesh
	return mesh


## Kit voxel (x, y, z) (Blender axes: y to the back, z up) to Godot metres (y up, front +z).
static func _g(x: float, y: float, z: float) -> Vector3:
	return Vector3(x * VOX, z * VOX, -y * VOX)


static func _face(st: SurfaceTool, c: Vector3i, d: Vector3i, col: Color) -> void:
	# The four corners of the cell's face towards d, in Blender voxel units.
	var x := float(c.x)
	var y := float(c.y)
	var z := float(c.z)
	var q: Array
	if d.x != 0:
		var fx := x + (1.0 if d.x > 0 else 0.0)
		q = [Vector3(fx, y, z), Vector3(fx, y + 1, z), Vector3(fx, y + 1, z + 1), Vector3(fx, y, z + 1)]
	elif d.y != 0:
		var fy := y + (1.0 if d.y > 0 else 0.0)
		q = [Vector3(x, fy, z), Vector3(x + 1, fy, z), Vector3(x + 1, fy, z + 1), Vector3(x, fy, z + 1)]
	else:
		var fz := z + (1.0 if d.z > 0 else 0.0)
		q = [Vector3(x, y, fz), Vector3(x + 1, y, fz), Vector3(x + 1, y + 1, fz), Vector3(x, y + 1, fz)]
	_quad(st, q, _g(d.x, d.y, d.z), col)


## A chest print pixel: one front-facing quad just in front of the torso's front plane (y = y0).
static func _decal(st: SurfaceTool, x: int, y0: int, z: int, col: Color) -> void:
	var fy := float(y0) - 0.06
	_quad(st, [Vector3(x, fy, z), Vector3(x + 1, fy, z), Vector3(x + 1, fy, z + 1), Vector3(x, fy, z + 1)], Vector3(0, 0, 1), col)


static func _quad(st: SurfaceTool, q: Array, n: Vector3, col: Color) -> void:
	var p := []
	for v: Vector3 in q:
		p.append(_g(v.x, v.y, v.z))
	# Wind the triangles so they face along n (front faces are clockwise in Godot).
	var flip: bool = (p[1] - p[0]).cross(p[2] - p[0]).dot(n) > 0.0
	var order := [0, 2, 1, 0, 3, 2] if flip else [0, 1, 2, 0, 2, 3]
	for i in order:
		st.set_color(col)
		st.set_normal(n)
		st.add_vertex(p[i])


static func _material(glow: bool) -> StandardMaterial3D:
	if _mats.is_empty():
		var m := StandardMaterial3D.new()
		m.resource_name = "merch__matte"
		m.vertex_color_use_as_albedo = true
		m.vertex_color_is_srgb = true
		m.roughness = 0.85
		var g := StandardMaterial3D.new()
		g.resource_name = "merch__glow"
		g.vertex_color_use_as_albedo = true
		g.vertex_color_is_srgb = true
		g.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_mats = [m, g]
	return _mats[1 if glow else 0]

; Engine configuration file.
config_version=5

[application]

config/name="Black Cabin Tamagotchi"
config/version="0.2.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Needs="*res://scripts/needs.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/bc_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.th.translation", "res://i18n/strings_venue.en.translation", "res://i18n/strings_venue.th.translation", "res://i18n/strings_ui.en.translation", "res://i18n/strings_ui.th.translation", "res://i18n/strings_nightlife.en.translation", "res://i18n/strings_nightlife.th.translation", "res://i18n/strings_menu.en.translation", "res://i18n/strings_menu.th.translation")

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.05

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
viewport/hdr_2d=true
gl_compatibility/item_buffer_size=4096
limits/opengl/max_renderable_lights=48
lights_and_shadows/directional_shadow/size=2048

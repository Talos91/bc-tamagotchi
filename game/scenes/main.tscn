[sub_resource type="Shader" id="vignette_shader"]
code = "shader_type canvas_item;
// Mild vignette (art bible section 4): corners about 70% brightness.
uniform float strength = 0.3;
void fragment() {
	vec2 d = UV - vec2(0.5);
	float v = smoothstep(0.35, 0.85, length(d * vec2(1.0, 0.8)));
	COLOR = vec4(0.03, 0.0, 0.0, v * strength);
}
"

[sub_resource type="ShaderMaterial" id="vignette_mat"]
shader = SubResource("vignette_shader")

[node name="Main" type="Node3D"]
script = ExtResource("1")


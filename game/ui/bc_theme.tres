[gd_resource type="Theme" load_steps=9 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Lato-Bold.ttf" id="1_latob"]
[ext_resource type="FontFile" path="res://assets/fonts/Lato-Black.ttf" id="2_latok"]
[ext_resource type="FontFile" path="res://assets/fonts/Kristi-Regular.ttf" id="3_kristi"]
[ext_resource type="FontFile" path="res://assets/fonts/IBMPlexSansThaiLooped-SemiBold.ttf" id="4_plexsb"]

[sub_resource type="FontVariation" id="FontVariation_text"]
base_font = ExtResource("1_latob")
fallbacks = [ExtResource("4_plexsb")]

[sub_resource type="FontVariation" id="FontVariation_display"]
base_font = ExtResource("2_latok")
fallbacks = [ExtResource("4_plexsb")]

[sub_resource type="FontVariation" id="FontVariation_title"]
base_font = ExtResource("3_kristi")
fallbacks = [ExtResource("4_plexsb")]

[resource]
default_font = SubResource("FontVariation_text")
default_font_size = 15
LabelBody/base_type = &"Label"
LabelBody/font_sizes/font_size = 15
LabelBody/fonts/font = SubResource("FontVariation_text")
LabelBodyL/base_type = &"Label"
LabelBodyL/font_sizes/font_size = 17
LabelBodyL/fonts/font = SubResource("FontVariation_text")
LabelCaption/base_type = &"Label"
LabelCaption/font_sizes/font_size = 13
LabelCaption/fonts/font = SubResource("FontVariation_text")
LabelDisplayL/base_type = &"Label"
LabelDisplayL/font_sizes/font_size = 24
LabelDisplayL/fonts/font = SubResource("FontVariation_display")
LabelDisplayS/base_type = &"Label"
LabelDisplayS/font_sizes/font_size = 14
LabelDisplayS/fonts/font = SubResource("FontVariation_display")
LabelDisplayXL/base_type = &"Label"
LabelDisplayXL/font_sizes/font_size = 32
LabelDisplayXL/fonts/font = SubResource("FontVariation_display")
LabelTitle/base_type = &"Label"
LabelTitle/font_sizes/font_size = 32
LabelTitle/fonts/font = SubResource("FontVariation_title")
Button/font_sizes/font_size = 15
Button/fonts/font = SubResource("FontVariation_text")

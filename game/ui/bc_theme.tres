[gd_resource type="Theme" load_steps=16 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Lato-Bold.ttf" id="1_latob"]
[ext_resource type="FontFile" path="res://assets/fonts/Lato-Black.ttf" id="2_latok"]
[ext_resource type="FontFile" path="res://assets/fonts/Kristi-Regular.ttf" id="3_kristi"]
[ext_resource type="FontFile" path="res://assets/fonts/IBMPlexSansThaiLooped-SemiBold.ttf" id="4_plexsb"]
[ext_resource type="FontFile" path="res://assets/fonts/TiltNeon-Regular.ttf" id="5_tilt"]

[sub_resource type="FontVariation" id="FontVariation_text"]
base_font = ExtResource("1_latob")
fallbacks = [ExtResource("4_plexsb")]

[sub_resource type="FontVariation" id="FontVariation_display"]
base_font = ExtResource("2_latok")
fallbacks = [ExtResource("4_plexsb")]

[sub_resource type="FontVariation" id="FontVariation_title"]
base_font = ExtResource("3_kristi")
fallbacks = [ExtResource("4_plexsb")]

[sub_resource type="FontVariation" id="FontVariation_neon"]
base_font = ExtResource("5_tilt")
fallbacks = [ExtResource("4_plexsb")]

[sub_resource type="StyleBoxFlat" id="Btn_normal"]
content_margin_left = 28.0
content_margin_right = 28.0
bg_color = Color(0.137, 0.071, 0.063, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.71, 0.541, 0.298, 0.75)
corner_radius_top_left = 33
corner_radius_top_right = 33
corner_radius_bottom_right = 33
corner_radius_bottom_left = 33

[sub_resource type="StyleBoxFlat" id="Btn_pressed"]
content_margin_left = 28.0
content_margin_right = 28.0
bg_color = Color(0.22, 0.125, 0.102, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.71, 0.541, 0.298, 0.9)
corner_radius_top_left = 33
corner_radius_top_right = 33
corner_radius_bottom_right = 33
corner_radius_bottom_left = 33

[sub_resource type="StyleBoxFlat" id="Btn_disabled"]
content_margin_left = 28.0
content_margin_right = 28.0
bg_color = Color(0.137, 0.071, 0.063, 0.55)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.71, 0.541, 0.298, 0.3)
corner_radius_top_left = 33
corner_radius_top_right = 33
corner_radius_bottom_right = 33
corner_radius_bottom_left = 33

[sub_resource type="StyleBoxEmpty" id="Btn_focus"]

[resource]
